{
  "name": "@platform/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build:scripts": "tsc -p tsconfig.build.json",
    "db:generate": "pnpm dlx --allow-build=esbuild --package=drizzle-kit@0.31.10 --package=drizzle-orm@0.45.2 drizzle-kit generate",
    "db:migrate": "pnpm build:scripts && node --env-file=../../.env dist/scripts/migrate.js",
    "db:seed": "pnpm build:scripts && node --env-file=../../.env dist/scripts/seed.js",
    "db:reset": "pnpm build:scripts && node --env-file=../../.env dist/scripts/reset.js"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
